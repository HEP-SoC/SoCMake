include("${CMAKE_CURRENT_LIST_DIR}/../../../../CMakeLists.txt")

# The environment is shared by all the tests of the run, so each test restores
# ENV{CTEST_PARALLEL_LEVEL} to its initial value before returning.
macro(_save_ctest_parallel_level_env)
    if(DEFINED ENV{CTEST_PARALLEL_LEVEL})
        set(_saved_env_defined TRUE)
        set(_saved_env "$ENV{CTEST_PARALLEL_LEVEL}")
    else()
        set(_saved_env_defined FALSE)
    endif()
endmacro()

macro(_restore_ctest_parallel_level_env)
    if(_saved_env_defined)
        set(ENV{CTEST_PARALLEL_LEVEL} "${_saved_env}")
    else()
        unset(ENV{CTEST_PARALLEL_LEVEL})
    endif()
endmacro()

set(TEST_NAME socmake_ctest_parallel_level_argument)
ct_add_test(NAME ${TEST_NAME})
function(${${TEST_NAME}})
    _save_ctest_parallel_level_env()
    set(ENV{CTEST_PARALLEL_LEVEL} 5)
    socmake_ctest_parallel_level(level 3)
    _restore_ctest_parallel_level_env()
    ct_assert_equal(level 3)
endfunction()

set(TEST_NAME socmake_ctest_parallel_level_env)
ct_add_test(NAME ${TEST_NAME})
function(${${TEST_NAME}})
    _save_ctest_parallel_level_env()
    set(ENV{CTEST_PARALLEL_LEVEL} 5)
    socmake_ctest_parallel_level(level "")
    _restore_ctest_parallel_level_env()
    ct_assert_equal(level 5)
endfunction()

set(TEST_NAME socmake_ctest_parallel_level_processor_count)
ct_add_test(NAME ${TEST_NAME})
function(${${TEST_NAME}})
    _save_ctest_parallel_level_env()
    unset(ENV{CTEST_PARALLEL_LEVEL})
    socmake_ctest_parallel_level(level "")
    _restore_ctest_parallel_level_env()
    set(level_is_valid FALSE)
    if(level MATCHES "^[0-9]+$" AND level GREATER_EQUAL 1)
        set(level_is_valid TRUE)
    endif()
    ct_assert_true(level_is_valid)
endfunction()

set(TEST_NAME socmake_ctest_parallel_level_zero)
ct_add_test(NAME ${TEST_NAME})
function(${${TEST_NAME}})
    socmake_ctest_parallel_level(level 0)
    ct_assert_equal(level 1)
endfunction()

set(TEST_NAME socmake_ctest_parallel_level_invalid_fails)
ct_add_test(NAME ${TEST_NAME} EXPECTFAIL)
function(${${TEST_NAME}})
    socmake_ctest_parallel_level(level abc)
endfunction()
